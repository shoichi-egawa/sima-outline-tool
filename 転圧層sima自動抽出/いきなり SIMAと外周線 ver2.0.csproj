<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- 周りのDLL（ネイティブDLL含む）を丸ごと1本のEXEに閉じ込める設定 -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<AssemblyName>SimaOuterLine</AssemblyName>
		<RootNamespace>転圧層sima自動抽出</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="いきなりSIMAと外周ver2.1とりせつ.pdf" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="いきなりSIMAと外周ver2.1とりせつ.pdf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="netDxf" Version="2022.11.2" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

</Project>